<?php

///////////////////////////////////////////////////////////////////////////
// Configuration parameters

$debugLevel = 0;

// Point this to the directory containing TWCManager.py.
$twcScriptDir = "/srv/TWCManager/";

// Application-level web authentication.
// Generate hashes with:
//   php -r 'echo password_hash("change-me", PASSWORD_DEFAULT), PHP_EOL;'
$webRequireAuth = true;
// Optional override for tesla_callback.php. Set to false if the helper must be
// reachable by Tesla without showing the local PHP login page first.
$webRequireAuthTeslaHelper = true;
$webUsername = 'admin';
$webPasswordHash = '';

// Session security.
$webSessionIdleTimeoutSeconds = 1800;
$webSessionAbsoluteTimeoutSeconds = 43200;
// Use Lax for OAuth flows so Tesla can return to tesla_callback.php with the
// same browser session. Strict will break OAuth state validation.
$webSessionCookieSameSite = 'Lax';

// Feature gates.
$webEnableDebugTools = false;
$webEnableTeslaHelper = true;

// Public HTTPS base URL for this web UI, without trailing slash.
// Example: https://twcmanager.local
$webBaseUrl = '';

// Whether to trust reverse-proxy client IP headers such as X-Forwarded-For.
$webTrustProxyHeaders = false;

// Separate security log file for authentication and administrative actions.
$webSecurityLogEnabled = true;
$webSecurityLogFile = '/var/log/twcmanager-web-security.log';

// End configuration parameters
///////////////////////////////////////////////////////////////////////////
